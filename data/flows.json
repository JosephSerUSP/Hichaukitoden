{
  "battle": {
    "battle_start": [
      {
        "cmd": "COMMENT",
        "text": "Enemy group composition: the troop named by the BATTLE command, or a weighted roll over the map's encounter table (which holds troop ids). Slot counts and levels belong to the troop, not to this phase."
      },
      {
        "cmd": "SPAWN_ENEMIES"
      },
      {
        "cmd": "RUN_TROOP_EVENTS",
        "at": "battle_start"
      },
      {
        "cmd": "COMMENT",
        "text": "Keep the `warded` state in step with whatever death ward the creature is currently carrying, so the player can SEE it before deciding to descend further."
      },
      {
        "cmd": "FOR_EACH",
        "scope": "slot_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "SYNC_TRAIT_STATE",
            "target": "ally",
            "trait": "ON_PERMADEATH",
            "state": "warded",
            "duration": 9999
          }
        ]
      }
    ],
    "round_start": [
      {
        "cmd": "COMMENT",
        "text": "Start of a round, before actions are collected. Nothing structural happens here yet -- the phase exists so a troop can act at the top of a round (a boss taunting, a hazard ticking) without that becoming engine code."
      },
      {
        "cmd": "RUN_TROOP_EVENTS",
        "at": "round_start"
      }
    ],
    "after_action": [
      {
        "cmd": "COMMENT",
        "text": "After a single turn resolves. This is the phase an HP threshold needs -- a boss changing form at half health should do so the moment the blow lands, not at the end of the round."
      },
      {
        "cmd": "RUN_TROOP_EVENTS",
        "at": "after_action"
      }
    ],
    "round_end": [
      {
        "cmd": "COMMENT",
        "text": "End-of-round ticks: HP drift and state decay for everyone, then the troop's round_end events (Strain lives on the base troop), then adjacency traits."
      },
      {
        "cmd": "STATE_TICKS"
      },
      {
        "cmd": "RUN_TROOP_EVENTS",
        "at": "round_end"
      },
      {
        "cmd": "COMMENT",
        "text": "Adjacency traits: SYMBIOSIS heals the creature beside it, PARASITE feeds on it. `neighbor` is the nearest living creature in an adjacent party slot, published per-iteration by FOR_EACH; with no living neighbour the commands no-op."
      },
      {
        "cmd": "FOR_EACH",
        "scope": "slot_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "IF",
            "condition": "ally.trait.SYMBIOSIS > 0",
            "then": [
              {
                "cmd": "HEAL",
                "target": "neighbor",
                "amount": "ally.trait.SYMBIOSIS"
              }
            ]
          },
          {
            "cmd": "IF",
            "condition": "ally.trait.PARASITE > 0",
            "then": [
              {
                "cmd": "DAMAGE",
                "target": "neighbor",
                "amount": "ally.trait.PARASITE",
                "pierce": true,
                "minHp": 1
              },
              {
                "cmd": "EMIT_TEXT",
                "term": "battle.parasite",
                "fallback": "{0} feeds on {1}!",
                "args": [
                  "ally.name",
                  "neighbor.name"
                ]
              }
            ]
          }
        ]
      }
    ],
    "defeat": [
      {
        "cmd": "COMMENT",
        "text": "Party wiped: signal the transition to the Game Over scene (E9). The scene's on_select hook resets the session via RESET_SESSION."
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "defeat",
        "scene": "game_over"
      }
    ],
    "escaped": [
      {
        "cmd": "REAP_FALLEN"
      },
      {
        "cmd": "COMMENT",
        "text": "Successful flee: signal the return-to-map transition (task A5e)."
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "map"
      },
      {
        "cmd": "COMMENT",
        "text": "Creature history: every creature still standing at the end of a fight has one more battle behind it. Reaped creatures are excluded -- their record is closed by REAP_FALLEN."
      },
      {
        "cmd": "FOR_EACH",
        "scope": "living_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "RECORD_HISTORY",
            "target": "ally",
            "field": "battles",
            "amount": "1"
          },
          {
            "cmd": "TICK_SAVOR",
            "target": "ally"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "weakened"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "defending"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "blind"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "silence"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "poison"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "berserk"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "provoke"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "magicGuard"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "sleep"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "petrify"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "charm"
          }
        ]
      }
    ],
    "flee_attempt": [
      {
        "cmd": "COMMENT",
        "text": "Flee roll: base chance + living party FLEE_CHANCE_BONUS; failure costs gold. Mirrors the legacy engine/battle.lua block (task A5c)."
      },
      {
        "cmd": "SET_VAR",
        "name": "roll",
        "value": "random()"
      },
      {
        "cmd": "IF",
        "condition": "v.roll < combat.baseFleeChance + party.trait.FLEE_CHANCE_BONUS",
        "then": [
          {
            "cmd": "EMIT_EVENT",
            "event": "flee_success"
          }
        ],
        "else": [
          {
            "cmd": "EMIT_TEXT",
            "term": "battle.flee_fail",
            "fallback": "Failed to escape!"
          },
          {
            "cmd": "GAIN_GOLD",
            "amount": "-random(combat.goldLossOnFleeMin, combat.goldLossOnFleeMax)"
          }
        ]
      }
    ],
    "victory": [
      {
        "cmd": "COMMENT",
        "text": "Victory rewards: gold roll (plus the party's GOLD_DIGGER trait sum), XP per survivor, POST_BATTLE_HEAL trait."
      },
      {
        "cmd": "GAIN_GOLD",
        "amount": "random(combat.victoryGoldMin, combat.victoryGoldMax) + party.trait.GOLD_DIGGER"
      },
      {
        "cmd": "FOR_EACH",
        "scope": "living_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "GRANT_XP",
            "target": "ally",
            "amount": "combat.victoryExp"
          },
          {
            "cmd": "HEAL",
            "target": "ally",
            "trait": "POST_BATTLE_HEAL"
          }
        ]
      },
      {
        "cmd": "COMMENT",
        "text": "Permadeath (Summoner rework): spirits still down at battle end are reaped and bank EXP at the sacrifice rate."
      },
      {
        "cmd": "REAP_FALLEN"
      },
      {
        "cmd": "COMMENT",
        "text": "Creature history: every creature still standing at the end of a fight has one more battle behind it. Reaped creatures are excluded -- their record is closed by REAP_FALLEN."
      },
      {
        "cmd": "FOR_EACH",
        "scope": "living_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "RECORD_HISTORY",
            "target": "ally",
            "field": "battles",
            "amount": "1"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "weakened"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "defending"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "blind"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "silence"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "poison"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "berserk"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "provoke"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "magicGuard"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "sleep"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "petrify"
          },
          {
            "cmd": "REMOVE_STATE",
            "target": "ally",
            "state": "charm"
          }
        ]
      }
    ],
    "encounter_check": [
      {
        "cmd": "ROLL_ENCOUNTER",
        "chance": "session.encounterRate"
      }
    ]
  },
  "_test": {
    "scene": [
      {
        "cmd": "COMMENT",
        "text": "Validator-only phase: exercises every non-interactive command in immediate mode."
      },
      {
        "cmd": "SET_VAR",
        "name": "bonus",
        "value": "floor(session.floor * 2) + random(1, 2)"
      },
      {
        "cmd": "SET_FLAG",
        "flag": "_test_flag",
        "value": true
      },
      {
        "cmd": "IF",
        "condition": "flag:_test_flag",
        "then": [
          {
            "cmd": "GAIN_GOLD",
            "amount": "v.bonus",
            "comment": "per-command comment fields must be ignored"
          }
        ],
        "else": [
          {
            "cmd": "GAIN_GOLD",
            "amount": "9999"
          }
        ]
      },
      {
        "cmd": "SET_FLAG",
        "flag": "_test_flag",
        "value": false
      },
      {
        "cmd": "FOR_EACH",
        "scope": "living_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "GRANT_XP",
            "target": "ally",
            "amount": "1"
          },
          {
            "cmd": "HEAL",
            "target": "ally",
            "trait": "POST_BATTLE_HEAL"
          }
        ]
      },
      {
        "cmd": "FOR_EACH",
        "scope": "living_enemies",
        "as": "enemy",
        "do": [
          {
            "cmd": "DAMAGE",
            "target": "enemy",
            "amount": "2 + enemy.level"
          }
        ]
      },
      {
        "cmd": "FOR_EACH",
        "scope": "party",
        "as": "ally",
        "do": [
          {
            "cmd": "HEAL",
            "target": "ally",
            "amount": "3"
          }
        ]
      },
      {
        "cmd": "ADD_STATE",
        "target": "summoner",
        "state": "regen",
        "duration": 2
      },
      {
        "cmd": "STATE_TICKS"
      },
      {
        "cmd": "REMOVE_STATE",
        "target": "summoner",
        "state": "regen"
      },
      {
        "cmd": "CHANGE_MP",
        "amount": "-1"
      },
      {
        "cmd": "CHANGE_MP",
        "amount": "1"
      },
      {
        "cmd": "CHANGE_ITEM",
        "item": 1,
        "count": 1
      },
      {
        "cmd": "CHANGE_ITEM",
        "item": 1,
        "count": -1
      },
      {
        "cmd": "EMIT_TEXT",
        "term": "battle.victory_full",
        "fallback": "Test text."
      },
      {
        "cmd": "EMIT_EVENT",
        "event": "_test_event",
        "value": "1 + 1"
      },
      {
        "cmd": "SCENE_EVENT",
        "kind": "map"
      },
      {
        "cmd": "SCRIPT",
        "code": "api.damage(ctx.target, 5)\napi.emit({ type = 'text', text = 'script ran, floor ' .. ctx.session.floor })"
      }
    ],
    "script_escape": [
      {
        "cmd": "COMMENT",
        "text": "Negative test: the validator expects this phase to ERROR while scripting.allowRawAccess is false."
      },
      {
        "cmd": "SCRIPT",
        "code": "return os.time()"
      }
    ]
  },
  "quest": {
    "offer": [
      {
        "cmd": "COMMENT",
        "text": "Default quest offer logic"
      }
    ],
    "complete": [
      {
        "cmd": "QUEST_TAKE_REQUIREMENTS"
      },
      {
        "cmd": "QUEST_GRANT_REWARDS"
      }
    ]
  },
  "exploration": {
    "step": [
      {
        "cmd": "COMMENT",
        "text": "Runs once per successful player step (main.lua, before the encounter roll). Per-step trait effects live here so they stay data-authored: MOVE_HEAL regenerates while walking, reusing HEAL's trait form exactly like POST_BATTLE_HEAL does on victory."
      },
      {
        "cmd": "COMMENT",
        "text": "Traversal cost: exactly the combined MPD of the living manifested party, with no Summoner base cost. A lone MPD-1 creature can walk almost indefinitely; a heavy party pays for every step. Nothing is charged on a safe map. This replaced a flat dungeon.moveMpDrain in exploration.lua, which charged the same 1 MP whether the Summoner was carrying a Pixie or a Bahamut -- the entire expedition economy the design rests on was invisible."
      },
      {
        "cmd": "IF",
        "condition": "not session.mapSafe",
        "then": [
          {
            "cmd": "CHANGE_MP",
            "amount": "-(party.mpd)"
          }
        ]
      },
      {
        "cmd": "FOR_EACH",
        "scope": "living_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "HEAL",
            "target": "ally",
            "trait": "MOVE_HEAL"
          }
        ]
      },
      {
        "cmd": "COMMENT",
        "text": "Keep the `warded` state in step with whatever death ward the creature is currently carrying, so the player can SEE it before deciding to descend further."
      },
      {
        "cmd": "FOR_EACH",
        "scope": "slot_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "SYNC_TRAIT_STATE",
            "target": "ally",
            "trait": "ON_PERMADEATH",
            "state": "warded",
            "duration": 9999
          }
        ]
      }
    ],
    "expedition_start": [
      {
        "cmd": "COMMENT",
        "text": "Runs when the party leaves a safe map for a dangerous one (engine/exploration.lua loadMap). One expedition = one trip out of town, not one floor."
      },
      {
        "cmd": "FOR_EACH",
        "scope": "slot_allies",
        "as": "ally",
        "do": [
          {
            "cmd": "RECORD_HISTORY",
            "target": "ally",
            "field": "expeditions",
            "amount": "1"
          }
        ]
      }
    ]
  }
}
