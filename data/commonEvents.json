  "15": {
    "name": "Alicia Talk Hub",
    "commands": [
      {
        "name": "alicia_talk_hub",
        "cmd": "LABEL"
      },
      {
        "text": "(She fiddles with a loose thread on her apron, waiting for you to speak.)",
        "speaker": "Alicia",
        "cmd": "TEXT"
      },
      {
        "options": [
          {
            "label": "About Laura",
            "commands": [
              {
                "text": "Laura? She’s… she’s amazing. She’s strong, and beautiful, and… and she smells like vanilla and iron. Is that weird? That’s weird. Forget I said that.",
                "speaker": "Alicia",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "Ask about something else.",
                    "commands": [
                      {
                        "label": "alicia_talk_hub",
                        "cmd": "JUMP_TO_LABEL"
                      }
                    ]
                  },
                  {
                    "label": "I should get going.",
                    "commands": []
                  }
                ],
                "cmd": "CHOICE"
              }
            ]
          },
          {
            "label": "About Shop",
            "commands": [
              {
                "text": "I sell things that keep you alive! It makes me happy. Watching people leave with full bags… it means they might come back. That’s nice.",
                "speaker": "Alicia",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "Ask about something else.",
                    "commands": [
                      {
                        "label": "alicia_talk_hub",
                        "cmd": "JUMP_TO_LABEL"
                      }
                    ]
                  },
                  {
                    "label": "I should get going.",
                    "commands": []
                  }
                ],
                "cmd": "CHOICE"
              }
            ]
          },
          {
            "label": "About You",
            "commands": [
              {
                "text": "Me? I’m just Alicia. I like baking. And… I like listening to the rain. The dungeon is scary, but the rain makes it sound like it’s sleeping.",
                "speaker": "Alicia",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "Ask about something else.",
                    "commands": [
                      {
                        "label": "alicia_talk_hub",
                        "cmd": "JUMP_TO_LABEL"
                      }
                    ]
                  },
                  {
                    "label": "I should get going.",
                    "commands": []
                  }
                ],
                "cmd": "CHOICE"
              }
            ]
          },
          {
            "label": "Ask about Quest",
            "commands": [
              {
                "condition": "questStatus:sparkling_gift:completed",
                "commands": [
                  {
                    "text": "I’m going to make this into a necklace. Or maybe a ring? No, a necklace. She doesn’t like rings when she works. Thank you again!",
                    "speaker": "Alicia",
                    "cmd": "TEXT"
                  },
                  {
                    "label": "alicia_talk_hub",
                    "cmd": "JUMP_TO_LABEL"
                  }
                ],
                "elseCommands": [
                  {
                    "condition": "questStatus:sparkling_gift:active",
                    "commands": [
                      {
                        "text": "The Glittering Teardrop… please be careful. It’s pretty, but the dungeon is mean. Don’t get hurt for a rock, okay?",
                        "speaker": "Alicia",
                        "cmd": "TEXT"
                      },
                      {
                        "condition": "hasItem:24",
                        "commands": [
                          {
                            "text": "You… you found it! Oh, look at it! It’s perfect. It catches the light just like her eyes when she’s happy. Thank you! Thank you so much!",
                            "speaker": "Alicia",
                            "cmd": "TEXT"
                          },
                          {
                            "options": [
                              {
                                "label": "Here you go.",
                                "commands": [
                                  {
                                    "questId": "sparkling_gift",
                                    "cmd": "QUEST_COMPLETE"
                                  },
                                  {
                                    "text": "I’m going to make this into a necklace. Or maybe a ring? No, a necklace. She doesn’t like rings when she works. Thank you again!",
                                    "speaker": "Alicia",
                                    "cmd": "TEXT"
                                  },
                                  {
                                    "label": "alicia_talk_hub",
                                    "cmd": "JUMP_TO_LABEL"
                                  }
                                ]
                              }
                            ],
                            "cmd": "CHOICE"
                          }
                        ],
                        "elseCommands": [
                          {
                            "options": [
                              {
                                "label": "I'm still looking.",
                                "commands": [
                                  {
                                    "label": "alicia_talk_hub",
                                    "cmd": "JUMP_TO_LABEL"
                                  }
                                ]
                              }
                            ],
                            "cmd": "CHOICE"
                          }
                        ],
                        "cmd": "CONDITIONAL_BRANCH"
                      }
                    ],
                    "elseCommands": [
                      {
                        "text": "Actually… can I ask a favor? It’s about Laura. I want to give her something special. Something that… shines like she does. There’s a crystal, a ‘Glittering Teardrop’, deep in the dungeon. Would you…?",
                        "speaker": "Alicia",
                        "cmd": "TEXT"
                      },
                      {
                        "options": [
                          {
                            "label": "I'll find it.",
                            "commands": [
                              {
                                "questId": "sparkling_gift",
                                "cmd": "QUEST_OFFER"
                              },
                              {
                                "text": "The Glittering Teardrop… please be careful. It’s pretty, but the dungeon is mean. Don’t get hurt for a rock, okay?",
                                "speaker": "Alicia",
                                "cmd": "TEXT"
                              },
                              {
                                "condition": "hasItem:24",
                                "commands": [
                                  {
                                    "text": "You… you found it! Oh, look at it! It’s perfect. It catches the light just like her eyes when she’s happy. Thank you! Thank you so much!",
                                    "speaker": "Alicia",
                                    "cmd": "TEXT"
                                  },
                                  {
                                    "options": [
                                      {
                                        "label": "Here you go.",
                                        "commands": [
                                          {
                                            "questId": "sparkling_gift",
                                            "cmd": "QUEST_COMPLETE"
                                          },
                                          {
                                            "text": "I’m going to make this into a necklace. Or maybe a ring? No, a necklace. She doesn’t like rings when she works. Thank you again!",
                                            "speaker": "Alicia",
                                            "cmd": "TEXT"
                                          },
                                          {
                                            "label": "alicia_talk_hub",
                                            "cmd": "JUMP_TO_LABEL"
                                          }
                                        ]
                                      }
                                    ],
                                    "cmd": "CHOICE"
                                  }
                                ],
                                "elseCommands": [
                                  {
                                    "options": [
                                      {
                                        "label": "I'm still looking.",
                                        "commands": [
                                          {
                                            "label": "alicia_talk_hub",
                                            "cmd": "JUMP_TO_LABEL"
                                          }
                                        ]
                                      }
                                    ],
                                    "cmd": "CHOICE"
                                  }
                                ],
                                "cmd": "CONDITIONAL_BRANCH"
                              }
                            ]
                          },
                          {
                            "label": "Maybe later.",
                            "commands": [
                              {
                                "label": "alicia_talk_hub",
                                "cmd": "JUMP_TO_LABEL"
                              }
                            ]
                          }
                        ],
                        "cmd": "CHOICE"
                      }
                    ],
                    "cmd": "CONDITIONAL_BRANCH"
                  }
                ],
                "cmd": "CONDITIONAL_BRANCH"
              }
            ]
          },
          {
            "label": "That's enough talk for now.",
            "commands": []
          }
        ],
        "cmd": "CHOICE"
      }
    ]
  },
  "17": {
    "name": "Laura Talk Hub",
    "commands": [
      {
        "name": "laura_talk_hub",
        "cmd": "LABEL"
      },
      {
        "text": "(She wipes soot from her forehead, giving you a brief moment of attention.)",
        "speaker": "Laura",
        "cmd": "TEXT"
      },
      {
        "options": [
          {
            "label": "About Alicia",
            "commands": [
              {
                "text": "Alicia? She's... soft. Too soft for this place. But she makes good bread. And she doesn't ask stupid questions. I tolerate her.",
                "speaker": "Laura",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "Ask about something else.",
                    "commands": [
                      {
                        "label": "laura_talk_hub",
                        "cmd": "JUMP_TO_LABEL"
                      }
                    ]
                  },
                  {
                    "label": "I'm going.",
                    "commands": []
                  }
                ],
                "cmd": "CHOICE"
              }
            ]
          },
          {
            "label": "About Smithing",
            "commands": [
              {
                "text": "Fire purifies. Metal obeys. People... people lie. Steel never lies to you. It just is. That's why I like it.",
                "speaker": "Laura",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "Ask about something else.",
                    "commands": [
                      {
                        "label": "laura_talk_hub",
                        "cmd": "JUMP_TO_LABEL"
                      }
                    ]
                  },
                  {
                    "label": "I'm going.",
                    "commands": []
                  }
                ],
                "cmd": "CHOICE"
              }
            ]
          },
          {
            "label": "Ask about Quest",
            "commands": [
              {
                "condition": "questStatus:golden_promise:completed",
                "commands": [
                  {
                    "text": "I'll need time to work on this. Check back later. And... thanks.",
                    "speaker": "Laura",
                    "cmd": "TEXT"
                  },
                  {
                    "label": "laura_talk_hub",
                    "cmd": "JUMP_TO_LABEL"
                  }
                ],
                "elseCommands": [
                  {
                    "condition": "questStatus:golden_promise:active",
                    "commands": [
                      {
                        "text": "Find that signet. Don't come back empty-handed.",
                        "speaker": "Laura",
                        "cmd": "TEXT"
                      },
                      {
                        "condition": "hasItem:25",
                        "commands": [
                          {
                            "text": "You found it. Hmph. Not bad. The gold is pure... untouched. Give it here.",
                            "speaker": "Laura",
                            "cmd": "TEXT"
                          },
                          {
                            "options": [
                              {
                                "label": "Hand it over.",
                                "commands": [
                                  {
                                    "questId": "golden_promise",
                                    "cmd": "QUEST_COMPLETE"
                                  },
                                  {
                                    "text": "I'll need time to work on this. Check back later. And... thanks.",
                                    "speaker": "Laura",
                                    "cmd": "TEXT"
                                  },
                                  {
                                    "label": "laura_talk_hub",
                                    "cmd": "JUMP_TO_LABEL"
                                  }
                                ]
                              }
                            ],
                            "cmd": "CHOICE"
                          }
                        ],
                        "elseCommands": [
                          {
                            "options": [
                              {
                                "label": "Still looking.",
                                "commands": [
                                  {
                                    "label": "laura_talk_hub",
                                    "cmd": "JUMP_TO_LABEL"
                                  }
                                ]
                              }
                            ],
                            "cmd": "CHOICE"
                          }
                        ],
                        "cmd": "CONDITIONAL_BRANCH"
                      }
                    ],
                    "elseCommands": [
                      {
                        "text": "You're going deep? Listen. Rumor says a rare undead down there wears a golden band. Unmarked, untarnished. I want that signet — new material for my forge, good pay for you. Interested?",
                        "speaker": "Laura",
                        "cmd": "TEXT"
                      },
                      {
                        "options": [
                          {
                            "label": "I'll look for it.",
                            "commands": [
                              {
                                "questId": "golden_promise",
                                "cmd": "QUEST_OFFER"
                              },
                              {
                                "text": "Find that signet. Don't come back empty-handed.",
                                "speaker": "Laura",
                                "cmd": "TEXT"
                              },
                              {
                                "condition": "hasItem:25",
                                "commands": [
                                  {
                                    "text": "You found it. Hmph. Not bad. The gold is pure... untouched. Give it here.",
                                    "speaker": "Laura",
                                    "cmd": "TEXT"
                                  },
                                  {
                                    "options": [
                                      {
                                        "label": "Hand it over.",
                                        "commands": [
                                          {
                                            "questId": "golden_promise",
                                            "cmd": "QUEST_COMPLETE"
                                          },
                                          {
                                            "text": "I'll need time to work on this. Check back later. And... thanks.",
                                            "speaker": "Laura",
                                            "cmd": "TEXT"
                                          },
                                          {
                                            "label": "laura_talk_hub",
                                            "cmd": "JUMP_TO_LABEL"
                                          }
                                        ]
                                      }
                                    ],
                                    "cmd": "CHOICE"
                                  }
                                ],
                                "elseCommands": [
                                  {
                                    "options": [
                                      {
                                        "label": "Still looking.",
                                        "commands": [
                                          {
                                            "label": "laura_talk_hub",
                                            "cmd": "JUMP_TO_LABEL"
                                          }
                                        ]
                                      }
                                    ],
                                    "cmd": "CHOICE"
                                  }
                                ],
                                "cmd": "CONDITIONAL_BRANCH"
                              }
                            ]
                          },
                          {
                            "label": "Not my job.",
                            "commands": [
                              {
                                "label": "laura_talk_hub",
                                "cmd": "JUMP_TO_LABEL"
                              }
                            ]
                          }
                        ],
                        "cmd": "CHOICE"
                      }
                    ],
                    "cmd": "CONDITIONAL_BRANCH"
                  }
                ],
                "cmd": "CONDITIONAL_BRANCH"
              }
            ]
          },
          {
            "label": "That's all.",
            "commands": []
          }
        ],
        "cmd": "CHOICE"
      }
    ]
  },
