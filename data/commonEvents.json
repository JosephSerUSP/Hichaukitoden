{
  "1": {
    "name": "Teleport",
    "label": "Stairs Down",
    "minimapColor": [
      0,
      0.8,
      0.8
    ],
    "commands": [
      {
        "text": "Go down the stairs?",
        "cmd": "TEXT"
      },
      {
        "options": [
          {
            "label": "Yes",
            "commands": [
              {
                "cmd": "COMMENT",
                "text": "Descends one floor. Dungeon maps are authored so that map id == depth + 1 (G1 enforces it), so the next floor down is session.floor + 2. There is no depth cap in code: the deepest map simply carries no stairs event."
              },
              {
                "text": "You are whisked away...",
                "cmd": "TEXT"
              },
              {
                "cmd": "LOAD_MAP",
                "mapId": "session.floor + 2",
                "arrival": "entrance"
              }
            ]
          },
          {
            "label": "No",
            "commands": []
          }
        ],
        "cmd": "CHOICE"
      }
    ]
  },
