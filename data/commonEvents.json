  "33": {
    "name": "Gate Guard Allow Pass Hub",
    "commands": [
      {
        "name": "gate_guard_pass_hub",
        "cmd": "LABEL"
      },
      {
        "text": "Guild Pass verified. Keep your MP above the red line. Don’t be a hero in there— heroes become stains.",
        "cmd": "TEXT"
      },
      {
        "options": [
          {
            "label": "Enter Dungeon",
            "commands": [
              {
                "flag": "dungeon_entered",
                "value": true,
                "cmd": "SET_FLAG"
              },
              {
                "cmd": "COMMENT",
                "text": "Descends one floor. Dungeon maps are authored so that map id == depth + 1 (G1 enforces it), so the next floor down is session.floor + 2. There is no depth cap in code: the deepest map simply carries no stairs event."
              },
              {
                "text": "You are whisked away...",
                "cmd": "TEXT"
              },
              {
                "cmd": "LOAD_MAP",
                "mapId": "session.floor + 2"
              }
            ]
          },
          {
            "label": "Ask about stains.",
            "commands": [
              {
                "text": "People come back talking about ‘treasure’. Then they stop sleeping. Then they stop talking. Then we stop calling them by name. Go.",
                "cmd": "TEXT"
              },
              {
                "label": "gate_guard_pass_hub",
                "cmd": "JUMP_TO_LABEL"
              }
            ]
          },
          {
            "label": "Report Progress",
            "commands": [
              {
                "cmd": "COMMENT",
                "text": "This hub used to branch on flag:boss_killed_floor_6 / flag:boss_killed_floor_3, but no event in the game ever set either flag -- there are no boss events on floors 3 or 6 -- so two of the three replies were unreachable and only 'Still alive' could ever fire. G1 now rejects a condition on a flag nothing writes. Restore the branches together with the bosses that set the flags; the lines were: floor 6 -- \"You... you cleared the Sanctum? The air feels lighter today. Maybe it's not a coincidence. You're making history, Summoner.\" / floor 3 -- \"The Rusted Choir is silent? Good. Those bells were driving the dogs mad. Keep pushing deeper.\""
              },
              {
                "text": "Still alive. That's progress enough for today.",
                "cmd": "TEXT"
              },
              {
                "label": "gate_guard_pass_hub",
                "cmd": "JUMP_TO_LABEL"
              }
            ]
          },
          {
            "label": "Anything strange?",
            "commands": [
              {
                "text": "Strange? Always. But the supply shipment is late. Very late. It usually comes through the old tunnel, but it's silent.",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "I'll investigate.",
                    "commands": [
                      {
                        "questId": "silent_shipment",
                        "cmd": "QUEST_OFFER"
                      }
                    ]
                  },
                  {
                    "label": "Not my problem.",
                    "commands": []
                  }
                ],
                "cmd": "CHOICE"
              }
            ],
            "condition": "questStatus:silent_shipment:inactive"
          },
          {
            "label": "Leave",
            "commands": []
          }
        ],
        "cmd": "CHOICE"
      }
    ]
  },
  "34": {
    "name": "St. Maria Gate Hub",
    "commands": [
      {
        "name": "st_maria_gate",
        "cmd": "LABEL"
      },
      {
        "condition": "flag:vigil_held",
        "commands": [
          {
            "text": "The wax is still on the stones. One lantern burned until morning. Nobody admits it was theirs.",
            "speaker": "Gatekeeper",
            "cmd": "TEXT"
          }
        ],
        "elseCommands": [
          {
            "condition": "flag:vigil_ready",
            "commands": [
              {
                "text": "You came back under your own power. Good. Agnes has been waiting at the chapel. The first bell will sound at dusk.",
                "speaker": "Gatekeeper",
                "cmd": "TEXT"
              }
            ],
            "elseCommands": [
              {
                "condition": "flag:first_return",
                "commands": [
                  {
                    "text": "The lanterns gain another layer each time you return. St. Maria is learning the shape of you.",
                    "speaker": "Gatekeeper",
                    "cmd": "TEXT"
                  }
                ],
                "elseCommands": [
                  {
                    "text": "Beyond this gate, the boundary between souls gives way. Keep hold of your name. Your creatures can fight for you, but only you can keep summoning yourself.",
                    "speaker": "Gatekeeper",
                    "cmd": "TEXT"
                  }
                ],
                "cmd": "CONDITIONAL_BRANCH"
              }
            ],
            "cmd": "CONDITIONAL_BRANCH"
          }
        ],
        "cmd": "CONDITIONAL_BRANCH"
      },
      {
        "options": [
          {
            "label": "Enter the Labyrinth",
            "commands": [
              {
                "flag": "dungeon_entered",
                "value": true,
                "cmd": "SET_FLAG"
              },
              {
                "text": "The gate opens. For one breath, you feel yourself standing on both sides of it.",
                "cmd": "TEXT"
              },
              {
                "cmd": "LOAD_MAP",
                "mapId": "2"
              }
            ]
          },
          {
            "label": "Ask about the Vigil",
            "commands": [
              {
                "text": "One bell for those who came home. The second for those still below. We do not say dead here. The Labyrinth is particular about words.",
                "speaker": "Gatekeeper",
                "cmd": "TEXT"
              },
              {
                "label": "st_maria_gate",
                "cmd": "JUMP_TO_LABEL"
              }
            ]
          },
          {
            "label": "Return through the portal",
            "condition": "flag:portal_open",
            "commands": [
              {
                "cmd": "RETURN_TO_PORTAL"
              }
            ]
          },
          {
            "label": "Leave",
            "commands": []
          }
