  "35": {
    "name": "Chapel and Vigil",
    "commands": [
      {
        "condition": "flag:vigil_held",
        "commands": [
          {
            "text": "The chapel smells of cold wax and wet flowers. A single unclaimed lantern rests beneath the bell rope.",
            "cmd": "TEXT"
          },
          {
            "options": [
              {
                "label": "Read the lantern.",
                "commands": [
                  {
                    "text": "The card bears one name: THESTRA. The ink is fresh. The handwriting is yours.",
                    "cmd": "TEXT"
                  },
                  {
                    "flag": "thestra_lantern_seen",
                    "value": true,
                    "cmd": "SET_FLAG"
                  }
                ]
              },
              {
                "label": "Leave it alone.",
                "commands": []
              }
            ],
            "cmd": "CHOICE"
          }
        ],
        "elseCommands": [
          {
            "condition": "flag:vigil_ready",
            "commands": [
              {
                "text": "Lanterns crowd the chapel steps. Each carries a human name. Agnes holds an empty one aside for you.",
                "cmd": "TEXT"
              },
              {
                "options": [
                  {
                    "label": "Attend the Vigil.",
                    "commands": [
                      {
                        "text": "At dusk, St. Maria closes its shops. Bakers, guards, children and scavengers gather without being called.",
                        "cmd": "TEXT"
                      },
                      {
                        "text": "The first bell names the living. When Agnes speaks your name, the village answers: RETURNED.",
                        "cmd": "TEXT"
                      },
                      {
                        "text": "At midnight, lanterns are carried to the Labyrinth gate. The second bell names those who remain below.",
                        "cmd": "TEXT"
                      },
                      {
                        "text": "After the final name, something beneath St. Maria rings a third time.",
                        "cmd": "TEXT"
                      },
                      {
                        "text": "Every flame bends toward the gate. One extinguished lantern relights by itself.",
                        "cmd": "TEXT"
                      },
                      {
                        "flag": "vigil_held",
                        "value": true,
                        "cmd": "SET_FLAG"
                      }
                    ]
                  },
                  {
                    "label": "Not yet.",
                    "commands": [
                      {
                        "text": "Agnes nods. \"The village can wait. It has practice.\"",
                        "cmd": "TEXT"
                      }
                    ]
                  }
                ],
                "cmd": "CHOICE"
              }
            ],
            "elseCommands": [
              {
                "text": "Lantern frames hang from the chapel eaves. Most are still empty.",
                "cmd": "TEXT"
              },
              {
                "condition": "flag:first_return",
                "commands": [
                  {
                    "text": "The lantern frames are being painted now. Agnes says the Vigil begins only after St. Maria has seen you leave and return three times.",
                    "cmd": "TEXT"
                  }
                ],
                "elseCommands": [
                  {
                    "text": "A notice reads: THE VIGIL OF THE SECOND BELL WILL BE HELD AFTER THE NEW SUMMONER'S THIRD SAFE RETURN.",
                    "cmd": "TEXT"
                  }
                ],
                "cmd": "CONDITIONAL_BRANCH"
              }
            ],
            "cmd": "CONDITIONAL_BRANCH"
          }
        ],
        "cmd": "CONDITIONAL_BRANCH"
      }
    ]
  },
  "36": {
    "name": "Yukio Vigil Hub",
    "commands": [
      {
        "condition": "flag:vigil_held",
        "commands": [
          {
            "text": "Three bells. There are only two in the tower. I checked before you arrived.",
            "speaker": "Yukio",
            "cmd": "TEXT"
          },
          {
            "options": [
              {
                "label": "You attended after all.",
                "commands": [
                  {
                    "text": "I observed. Attendance implies belief.",
                    "speaker": "Yukio",
                    "cmd": "TEXT"
                  }
                ]
              },
              {
                "label": "Whose lantern did you carry?",
                "commands": [
                  {
                    "text": "You mistake possession for sentiment. A common Summoner's error.",
                    "speaker": "Yukio",
                    "cmd": "TEXT"
                  }
                ]
              },
              {
                "label": "Leave",
                "commands": []
              }
            ],
            "cmd": "CHOICE"
          }
        ],
        "elseCommands": [
          {
            "text": "You are the new Summoner. Try to survive until the Vigil. The village enjoys having a fresh name to read at the first bell.",
            "speaker": "Yukio",
            "cmd": "TEXT"
          },
          {
            "options": [
              {
                "label": "You're a Summoner too.",
                "commands": [
                  {
                    "text": "Yes. I simply learned that entering and returning are different disciplines.",
                    "speaker": "Yukio",
                    "cmd": "TEXT"
                  }
                ]
              },
              {
                "label": "Leave",
                "commands": []
              }
            ],
            "cmd": "CHOICE"
          }
        ],
        "cmd": "CONDITIONAL_BRANCH"
      }
    ]
  },
  "37": {
    "name": "Rusty Tankard Vigil Hub",
    "commands": [
      {
        "condition": "flag:vigil_held",
        "commands": [
          {
            "text": "The Tankard is open late for cleanup. Half the village is helping; the other half is pretending not to have a headache.",
            "cmd": "TEXT"
          },
          {
            "options": [
              {
                "label": "Ask about the third bell.",
                "commands": [
                  {
                    "text": "The bartender stops wiping the same cup. \"Two bells,\" she says. \"You heard two.\"",
                    "cmd": "TEXT"
                  }
                ]
              },
              {
                "label": "Buy a drink.",
                "commands": [
                  {
                    "shopId": 5,
                    "cmd": "OPEN_SHOP"
                  }
                ]
              },
              {
                "label": "Leave",
                "commands": []
              }
            ],
            "cmd": "CHOICE"
          }
        ],
        "elseCommands": [
          {
            "condition": "flag:first_return",
            "commands": [
              {
                "text": "Tables have been pushed against the walls. Children are threading flowers while the bartender counts cups for the Vigil.",
                "cmd": "TEXT"
              }
            ],
            "elseCommands": [
              {
                "text": "The Rusty Tankard smells of bread, lamp oil and fresh-cut flowers. Nobody admits that this is festival preparation.",
                "cmd": "TEXT"
              }
            ],
            "cmd": "CONDITIONAL_BRANCH"
          },
          {
            "options": [
              {
                "label": "Buy a drink.",
                "commands": [
                  {
                    "shopId": 5,
                    "cmd": "OPEN_SHOP"
                  }
                ]
              },
              {
                "label": "Ask about the lanterns.",
                "commands": [
                  {
                    "text": "\"Missing get a flame until dawn. Dead get darkness. Summons get neither.\" The bartender frowns. \"Old rule.\"",
                    "cmd": "TEXT"
                  }
                ]
              },
              {
                "label": "Leave",
                "commands": []
              }
            ],
            "cmd": "CHOICE"
          }
        ],
        "cmd": "CONDITIONAL_BRANCH"
      }
    ]
  },
  "38": {
    "name": "Alicia Vigil Hub",
    "commands": [
      {
        "name": "alicia_vigil_hub",
        "cmd": "LABEL"
      },
      {
        "condition": "flag:vigil_held",
        "commands": [
          {
            "text": "Alicia is scraping wax from a tray. One small lantern, hidden behind the counter, bears no human name.",
            "speaker": "Alicia",
            "cmd": "TEXT"
          }
        ],
        "elseCommands": [
          {
            "condition": "flag:first_return",
            "commands": [
              {
                "text": "You came back! Sorry—everyone keeps saying that as if we doubted you. I saved you a honey roll before the Vigil crowd takes them.",
                "speaker": "Alicia",
                "cmd": "TEXT"
              }
            ],
            "elseCommands": [
              {
                "text": "Oh! You're the new Summoner. I'm Alicia. Please drink water before you descend. People return looking like they forgot they have bodies.",
                "speaker": "Alicia",
                "cmd": "TEXT"
              }
            ],
            "cmd": "CONDITIONAL_BRANCH"
          }
        ],
        "cmd": "CONDITIONAL_BRANCH"
      },
      {
