                  {
                    "text": "\"The old rule says they don't need them.\" She covers the hidden lantern with a cloth. \"Old rules can be lonely.\"",
                    "speaker": "Alicia",
                    "cmd": "TEXT"
                  }
                ],
                "elseCommands": [
                  {
                    "text": "\"Officially? We don't make them.\" Alicia lowers her voice. \"But if one of yours needs a light, tell me its name.\"",
                    "speaker": "Alicia",
                    "cmd": "TEXT"
                  }
                ],
                "cmd": "CONDITIONAL_BRANCH"
              },
              {
                "label": "alicia_vigil_hub",
                "cmd": "JUMP_TO_LABEL"
              }
            ]
          },
