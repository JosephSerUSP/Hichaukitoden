{
  "effectType": {
    "id": "barrier",
    "label": "Stack Barrier",
    "params": ["id", "match", "stacks", "reduction", "maxStacks", "duration", "mode"],
    "description": "Grants or updates an encounter-local stack barrier. `match` is physical_damage, magical_damage, or hostile_status; each matching resolved instance consumes one stack. `reduction` is 0..1 (1 = full negate). `mode` is add, set, or refresh; refresh raises the stack count to at least `stacks` without blind accumulation. `duration` is optional and measured in completed rounds.",
    "display": { "short": "Barrier", "polarity": "higher", "value": "none" }
  },
  "traitCode": {
    "code": "BARRIER_GRANT",
    "label": "Barrier Grant",
    "usesDataId": false,
    "params": ["id", "match", "stacks", "reduction", "maxStacks", "duration", "mode", "at"],
    "description": "Grants a generic stack barrier from an actor, passive, equipment piece, or state. `at` is battle_start or round_start; round_start defaults to refresh semantics so producers can restore a minimum without stockpiling.",
    "display": { "short": "Barrier", "value": "none", "polarity": "higher" }
  },
  "commands": [
    {
      "id": "BARRIER", "category": "Battle", "label": "Grant Barrier",
      "params": [
        { "key": "target", "type": "battlerRef" },
        { "key": "id", "type": "text" },
        { "key": "match", "type": "select", "options": ["physical_damage", "magical_damage", "hostile_status"] },
        { "key": "stacks", "type": "number", "min": 1 },
        { "key": "reduction", "type": "number", "min": 0.000001, "max": 1 },
        { "key": "maxStacks", "type": "number", "optional": true, "min": 1 },
        { "key": "duration", "type": "number", "optional": true, "min": 1 },
        { "key": "mode", "type": "select", "optional": true, "options": ["add", "set", "refresh"] }
      ],
      "contexts": ["battle_phase", "map", "common"],
      "interactive": false,
      "description": "Grants/adds/sets/refreshes a stack barrier on a battler using the same schema as the barrier effect."
    },
    {
      "id": "BARRIER_SYNC", "category": "Battle", "label": "Sync Barriers",
      "params": [
        { "key": "target", "type": "battlerRef" },
        { "key": "trigger", "type": "select", "options": ["battle_start", "round_start", "round_end"] }
      ],
      "contexts": ["battle_phase"],
      "interactive": false,
      "description": "Barrier lifecycle hook. battle_start clears encounter-local stacks and grants BARRIER_GRANT traits; round_start refreshes producers; round_end ages optional durations."
    }
  ],
  "damageKindEffects": ["hp_damage", "hp_drain"],
  "flowHooks": {
    "battle.battle_start": {
      "after": "SPAWN_ENEMIES",
      "commands": [
        { "cmd": "FOR_EACH", "scope": "living_allies", "as": "ally", "do": [
          { "cmd": "BARRIER_SYNC", "target": "ally", "trigger": "battle_start" }
        ] },
        { "cmd": "FOR_EACH", "scope": "living_enemies", "as": "enemy", "do": [
          { "cmd": "BARRIER_SYNC", "target": "enemy", "trigger": "battle_start" }
        ] }
      ]
    },
    "battle.round_start": {
      "before": "RUN_TROOP_EVENTS",
      "commands": [
        { "cmd": "FOR_EACH", "scope": "living_allies", "as": "ally", "do": [
          { "cmd": "BARRIER_SYNC", "target": "ally", "trigger": "round_start" }
        ] },
        { "cmd": "FOR_EACH", "scope": "living_enemies", "as": "enemy", "do": [
          { "cmd": "BARRIER_SYNC", "target": "enemy", "trigger": "round_start" }
        ] }
      ]
    },
    "battle.round_end": {
      "commands": [
        { "cmd": "FOR_EACH", "scope": "living_allies", "as": "ally", "do": [
          { "cmd": "BARRIER_SYNC", "target": "ally", "trigger": "round_end" }
        ] },
        { "cmd": "FOR_EACH", "scope": "living_enemies", "as": "enemy", "do": [
          { "cmd": "BARRIER_SYNC", "target": "enemy", "trigger": "round_end" }
        ] }
      ]
    },
    "_test.scene": {
      "commands": [
        { "cmd": "BARRIER", "target": "summoner", "id": "_validator_barrier", "match": "magical_damage", "stacks": 1, "reduction": 1, "maxStacks": 1, "mode": "set" },
        { "cmd": "BARRIER_SYNC", "target": "summoner", "trigger": "round_end" }
      ]
    }
  }
}
