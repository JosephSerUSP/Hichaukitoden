
# Local campaign selection pointer (per-machine; written by the title selector / editor)
campaign.json

# Player save files (per-machine; written by engine/savegame.lua)
saves/
screenshots/
node_modules/

# Local image-generation working files. Runtime art belongs in assets/ at its
# native game dimensions; high-resolution sources stay outside the repository.
assets/**/*_master.png
assets/portraits/source/
tools/image/*preview*.png
tmp/imagegen/
tmp/art-reference/

# Staged art from tools/asset-gen (raw model output + candidates; promote what you keep)
tools/asset-gen/out/

# Python bytecode from tools/asset-gen
__pycache__/
*.pyc

# G5 diff output: the frames a failing check-screens run actually produced,
# written next to their references for eyeballing. Disposable -- the
# references in tools/golden/screens/ are the tracked artifact.
tools/golden/screens-actual/

# G5 gallery output
tools/golden/gallery/

# G6 diff output: same deal for the editor gate. The tracked artifact is
# tools/golden/editor-screens/.
tools/golden/editor-screens-actual/

# Effekseer shim build artifact (6.1MB). Rebuild with tools/effekseer/build.ps1.
# Nothing here is a fallback: a stale shim is refused at init by name, so if a
# gate says the DLL is out of date, rebuild rather than hunting for a copy.
tools/effekseer/**/*.dll
effekseer_shim.dll
effekseer_shim.dll.*

# Local ML venv for the depth tooling (multi-GB torch); see docs/design/image-authored-geometry.md
tools/asset-gen/.venv/

# Model census generated products. Authored source inputs and the
# checksum-pinned .census-bootstrap remain tracked.
assets/models/second_rite_census/
out/model-census-review/
docs/reports/second-rite-model-census/evaluation.json
docs/reports/second-rite-model-census/evaluation.csv
docs/reports/second-rite-model-census/all-models.md
docs/reports/second-rite-model-census/failed-models.md
docs/reports/second-rite-model-census/contact-sheet-*.png
docs/reports/second-rite-model-census/failed-models-contact-sheet.png
docs/reports/second-rite-model-census/material-swatches.png
