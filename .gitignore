
# Local campaign selection pointer (per-machine; written by the title selector / editor)
campaign.json

# Player save files (per-machine; written by engine/savegame.lua)
saves/
screenshots/
node_modules/

# Local image-generation working files. Runtime art belongs in assets/ at its
# native game dimensions; high-resolution sources stay outside the repository.
assets/**/*_master.png
assets/portraits/source/
tools/image/*preview*.png
tmp/imagegen/
tmp/art-reference/

# Staged art from tools/asset-gen (raw model output + candidates; promote what you keep)
tools/asset-gen/out/

# Python bytecode from tools/asset-gen
__pycache__/
*.pyc

# G5 diff output: the frames a failing check-screens run actually produced,
# written next to their references for eyeballing. Disposable -- the
# references in tools/golden/screens/ are the tracked artifact.
tools/golden/screens-actual/

# Effekseer shim build artifact (6.4MB; rebuild per tools/effekseer/README.md)
tools/effekseer/**/*.dll
